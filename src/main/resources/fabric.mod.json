{
  "schemaVersion": 1,
  "id": "lightningflash",
  "version": "${version}",

  "name": "Lightning Flash",
  "description": "Makes mobs flash white when struck by lightning",
  "authors": ["creoii"],
  "contact": {},

  "license": "All-Rights-Reserved",
  "icon": "assets/lightningflash/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": ["dev.creoii.lightningflash.LightningFlash"],
    "client": ["dev.creoii.lightningflash.client.LightningFlashClient"],
    "modmenu": ["dev.creoii.lightningflash.compat.ModMenuIntegration"]
  },

  "mixins": [
    "lightningflash.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "parent": {
        "id": "great_big_world",
        "name": "Great Big World",
        "description": ""
      }
    }
  }
